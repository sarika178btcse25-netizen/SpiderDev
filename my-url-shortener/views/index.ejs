<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My URL Shortener</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <h1 class="text-center mb-4"> URL Shortener</h1>
        
        
        <form action="/shortUrls" method="POST" class="d-flex mb-5">
            <input required placeholder="Paste your long URL here..." type="url" name="fullUrl" class="form-control me-2">
            <button class="btn btn-success" type="submit">Shrink It!</button>
        </form>

        
        <table class="table table-striped table-responsive">
            <thead>
                <tr>
                    <th>Full URL</th>
                    <th>Short URL</th>
                    <th>Clicks</th>
                </tr>
            </thead>
            <tbody>
                
                <% urls.forEach(url => { %>
                    <tr>
                        <td><a href="<%= url.full %>" target="_blank"><%= url.full %></a></td>
                        <td><a href="<%= url.short %>" target="_blank"><%= url.short %></a></td>
                        <td><%= url.clicks %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>